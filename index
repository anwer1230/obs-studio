import { useEffect, useState } from "react";
import { motion, AnimatePresence } from "framer-motion";

const services = [
  { title: "تصميم مواقع احترافية", desc: "إنشاء مواقع سريعة وجذابة." },
  { title: "تحليل البيانات", desc: "تقديم تقارير دقيقة ومرئية." },
  { title: "برمجة تطبيقات", desc: "تطوير تطبيقات متقدمة ومتجاوبة." },
  { title: "استشارات تقنية", desc: "تقديم حلول واستراتيجيات تقنية." },
  { title: "تسويق رقمي", desc: "حملات تسويق مبتكرة وفعالة." },
  { title: "إدارة شبكات", desc: "تحسين الأداء واستقرار الشبكات." },
  { title: "أمن معلومات", desc: "حماية الأنظمة والبيانات الحساسة." },
  { title: "دعم فني", desc: "خدمات دعم وحلول سريعة." },
];

export default function ServicesShowcase() {
  const [index, setIndex] = useState(0);
  const [showAll, setShowAll] = useState(false);

  useEffect(() => {
    if (showAll) return;
    const timer = setTimeout(() => {
      if (index < services.length - 1) {
        setIndex((prev) => prev + 1);
      } else {
        setShowAll(true);
      }
    }, 2500); // مدة عرض كل خدمة قبل الانتقال
    return () => clearTimeout(timer);
  }, [index, showAll]);

  return (
    <div className="flex flex-col items-center justify-center min-h-screen p-6 bg-gradient-to-r from-blue-300 via-purple-300 to-pink-300">
      <h1 className="text-3xl md:text-4xl font-bold text-gray-800 mb-10 drop-shadow-lg">
        خدماتنا المميزة
      </h1>

      {/* عرض كل خدمة بشكل فردي */}
      {!showAll && (
        <AnimatePresence mode="wait">
          <motion.div
            key={index}
            initial={{ opacity: 0, scale: 0.8, y: 50, rotate: -5 }}
            animate={{ opacity: 1, scale: 1, y: 0, rotate: 0 }}
            exit={{ opacity: 0, scale: 0.8, y: -50, rotate: 5 }}
            transition={{ duration: 0.9, ease: "easeInOut" }}
            className="bg-white/70 backdrop-blur-lg rounded-2xl shadow-2xl p-8 w-80 text-center border border-gray-200 hover:shadow-pink-400 hover:shadow-lg transform hover:scale-105 transition"
          >
            <h2 className="text-xl font-semibold text-blue-600 drop-shadow-sm">
              {services[index].title}
            </h2>
            <p className="text-gray-700 mt-4">{services[index].desc}</p>
          </motion.div>
        </AnimatePresence>
      )}

      {/* عرض جميع الخدمات بعد الانتهاء */}
      {showAll && (
        <motion.div
          className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-10"
          initial="hidden"
          animate="visible"
          variants={{
            hidden: {},
            visible: {
              transition: {
                staggerChildren: 0.25,
              },
            },
          }}
        >
          {services.map((service, i) => (
            <motion.div
              key={i}
              className="bg-white/80 backdrop-blur-md rounded-xl p-6 shadow-lg hover:shadow-2xl hover:shadow-purple-400 transition transform hover:-translate-y-2 border border-gray-200"
              variants={{
                hidden: { opacity: 0, y: 50, scale: 0.9 },
                visible: { opacity: 1, y: 0, scale: 1 },
              }}
              whileHover={{ scale: 1.07, rotate: 1 }}
            >
              <h3 className="text-lg font-bold text-purple-700 mb-2 drop-shadow-sm">
                {service.title}
              </h3>
              <p className="text-gray-700">{service.desc}</p>
            </motion.div>
          ))}
        </motion.div>
      )}

      {/* زر إعادة التشغيل */}
      {showAll && (
        <motion.button
          className="mt-8 px-6 py-3 rounded-xl bg-purple-500 text-white font-semibold shadow-md hover:bg-purple-600 hover:shadow-lg transition"
          whileHover={{ scale: 1.05 }}
          onClick={() => {
            setShowAll(false);
            setIndex(0);
          }}
        >
          إعادة العرض
        </motion.button>
      )}
    </div>
  );
}
    button:hover {
      background: #520a85;
    }
  </style>
</head>
<body>
  <h1>🎓 خدماتنا الطلابية الشاملة</h1>

  <!-- صندوق الخدمة الفردي -->
  <div id="single-service" class="service-box"></div>

  <!-- الشبكة التي تعرض جميع الخدمات -->
  <div id="all-services" class="services-grid"></div>

  <button id="restart" style="display:none;">إعادة العرض</button>

  <script>
    const services = [
      "📘 حلول مناهج Evolve (1-2-3) الكاملة والموثوقة",
      "🌍 حلول مناهج Cambridge بشهادة خبراء",
      "🛒 أكواد جديدة ومضمونة لمنصة Evolve",
      "✍️ كتابة وتنظيم رسائل الماجستير والدكتوراه",
      "📊 إعداد البحوث العلمية والتقارير ومشاريع التخرج",
      "✅ حل الواجبات المنزلية والاختبارات والأنشطة بدقة",
      "📖 تلخيص الكتب والمحاضرات بشكل احترافي",
      "🎨 تصميم عروض بوربوينت وإنفوجرافيك مذهلة",
      "📄 إعداد سيرة ذاتية (CV) احترافية",
      "🌐 خدمات الترجمة الأكاديمية والمهنية بدقة"
    ];

    const singleBox = document.getElementById("single-service");
    const allBox = document.getElementById("all-services");
    const restartBtn = document.getElementById("restart");

    // ملء جميع الخدمات في الشبكة
    function fillAllServices() {
      allBox.innerHTML = "";
      services.forEach(service => {
        const div = document.createElement("div");
        div.className = "service-box show";
        div.textContent = service;
        allBox.appendChild(div);
      });
    }

    let index = 0;

    function showSequential() {
      restartBtn.style.display = "none";
      allBox.classList.remove("show-all");
      singleBox.textContent = "";
      singleBox.classList.remove("show");
      index = 0;
      const interval = setInterval(() => {
        if (index < services.length) {
          singleBox.classList.remove("show");
          setTimeout(() => {
            singleBox.textContent = services[index];
            singleBox.classList.add("show");
          }, 200);
          index++;
        } else {
          clearInterval(interval);
          setTimeout(() => {
            fillAllServices();
            allBox.classList.add("show-all");
            restartBtn.style.display = "inline-block";
          }, 1000);
        }
      }, 2500);
    }

    restartBtn.addEventListener("click", showSequential);

    // بدء العرض عند تحميل الصفحة
    window.onload = showSequential;
  </script>
</body>
</html>
